{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMqOptions": {
    "Exchange": "clinic-exchange",
    "ExchangeType": "direct",
    "PublishMaxRetries": 3,
    "BatchSize": 10,
    "BatchIntervalMs": 5000,
    "NetworkRecoveryIntervalSeconds": 5,
    "PublisherConfirmTimeoutMs": 5000,
    "ResponseQueue": "entity-generation-responses"
  }
}