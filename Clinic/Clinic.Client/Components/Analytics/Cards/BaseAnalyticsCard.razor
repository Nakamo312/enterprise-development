@using MudBlazor
@typeparam TItem

<MudCard Elevation="2" Class="@Class">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icon" Class="mr-2" /> @Title
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="d-flex flex-column flex-grow-1 p-0">
        @if (FilterContent != null)
        {
            <div class="p-3">
                @FilterContent
            </div>
        }

        <div class="text-center px-3 mb-2">
            <MudButton Variant="Variant.Filled"
                       Color="@ButtonColor"
                       Size="Size.Small"
                       StartIcon="@ButtonIcon"
                       OnClick="OnLoadData"
                       Disabled="@IsDisabled">
                @ButtonText
            </MudButton>
        </div>

        <div class="flex-grow-1 overflow-auto p-3">
            @if (IsLoading)
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="my-6">
                    <MudProgressCircular Color="@ButtonColor" Indeterminate="true" />
                    <MudText Typo="Typo.body2" Class="ml-3">Загрузка данных...</MudText>
                </MudStack>
            }
            else if (Items != null)
            {
                @if (Items.Count() != 0)
                {
                    <div>
                        @TableContent
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        @EmptyMessage
                    </MudAlert>
                }
            }
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Analytics;
    [Parameter] public string ButtonText { get; set; } = "Загрузить";
    [Parameter] public string ButtonIcon { get; set; } = Icons.Material.Filled.Download;
    [Parameter] public Color ButtonColor { get; set; } = Color.Primary;
    [Parameter] public string EmptyMessage { get; set; } = "Данные не найдены";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public RenderFragment? FilterContent { get; set; }
    [Parameter] public RenderFragment TableContent { get; set; } = default!;
    [Parameter] public EventCallback OnLoadData { get; set; }
    [Parameter] public string Class { get; set; } = "h-100 d-flex flex-column";
}
