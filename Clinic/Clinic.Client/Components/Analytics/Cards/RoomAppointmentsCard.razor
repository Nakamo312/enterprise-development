@using MudBlazor
@using Clinic.Application.Dtos.Appointments
@inject HttpClient Http

<BaseAnalyticsCard TItem="AppointmentResponseDto"
                   Title="Записи по кабинету (текущий месяц)"
                   Icon="@Icons.Material.Filled.MeetingRoom"
                   ButtonText="Найти записи"
                   ButtonIcon="@Icons.Material.Filled.Search"
                   ButtonColor="Color.Error"
                   Class="@Class"
                   Items="@_appointments"
                   IsLoading="@_isLoading"
                   IsDisabled="@string.IsNullOrWhiteSpace(_roomNumber)"
                   OnLoadData="LoadAppointmentsForRoom"
                   EmptyMessage="Записи в указанном кабинете не найдены">

    <FilterContent>
        <MudTextField T="string"
                      Label="Номер кабинета"
                      @bind-Value="@_roomNumber"
                      Placeholder="Например: 101"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Room" />
    </FilterContent>

    <TableContent>
        <MudTable 
            T="AppointmentResponseDto" 
            Items="@_appointments" 
            Hover="true"
            Class="flex-grow-1"
            Style="max-height: 300px; overflow-y: auto;">
            <HeaderContent>
                <MudTh>Дата и время</MudTh>
                <MudTh>Кабинет</MudTh>
                <MudTh>Повторный</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Дата и время">@context.DateTime.ToString("dd.MM.yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Кабинет">@context.RoomNumber</MudTd>
                <MudTd DataLabel="Повторный">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(context.IsRepeated ? Color.Warning : Color.Secondary)">
                        @(context.IsRepeated ? "Да" : "Нет")
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </TableContent>
</BaseAnalyticsCard>

@code {
    [Parameter] public string Class { get; set; } = "h-100 d-flex flex-column";
    private List<AppointmentResponseDto>? _appointments;
    private bool _isLoading = false;
    private string _roomNumber = "101";

    private async Task LoadAppointmentsForRoom()
    {
        if (string.IsNullOrWhiteSpace(_roomNumber)) return;

        _isLoading = true;

        try
        {
            var appointments = await Http.GetFromJsonAsync<List<AppointmentResponseDto>>(
                $"api/analytic/appointments/room?roomNumber={Uri.EscapeDataString(_roomNumber)}");
            _appointments = appointments?.OrderByDescending(a => a.DateTime).ToList();
        }
        catch
        {
            _appointments = null;
        }
        finally
        {
            _isLoading = false;
        }
    }
}