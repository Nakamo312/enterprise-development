@using MudBlazor

<MudCard Elevation="2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" /> Живая статистика
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudStack AlignItems="AlignItems.Center" Class="mb-4">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body2">Обновление данных...</MudText>
        </MudStack>
        
        <MudList T="object" Dense>
            <LiveStatItem 
                Icon="@Icons.Material.Filled.PersonAdd"
                Text="Новые пациенты"
                Value="+5"
                Color="Color.Success" />
                
            <LiveStatItem 
                Icon="@Icons.Material.Filled.CheckCircle"
                Text="Завершенные записи"
                Value="+3"
                Color="Color.Primary" />
                
            <LiveStatItem 
                Icon="@Icons.Material.Filled.PersonOutline"
                Text="Свободные врачи"
                Value="4"
                Color="Color.Warning" />
                
            <LiveStatItem 
                Icon="@Icons.Material.Filled.MedicalServices"
                Text="Текущие процедуры"
                Value="12"
                Color="Color.Info" />
                
            <LiveStatItem 
                Icon="@Icons.Material.Filled.AccessTime"
                Text="Среднее время ожидания"
                Value="15 мин"
                Color="Color.Secondary" />
        </MudList>
    </MudCardContent>
</MudCard>

