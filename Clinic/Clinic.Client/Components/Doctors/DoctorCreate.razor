@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Clinic.Application.Dtos.Doctors
@inject HttpClient Http

<div class="modal @(IsOpen ? "d-block" : "d-none")" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>

            @if (Model != null)
            {
                <EditForm Model="Model" OnValidSubmit="HandleValidSubmit" FormName="DoctorCreate">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger m-3" />

                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Паспорт *</label>
                                <InputText @bind-Value="Model.PassportNumber" 
                                          class="form-control" placeholder="1234 567890" />
                                <ValidationMessage For="@(() => Model.PassportNumber)" class="text-danger small" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">ФИО *</label>
                                <InputText @bind-Value="Model.FullName" 
                                          class="form-control" />
                                <ValidationMessage For="@(() => Model.FullName)" class="text-danger small" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Год рождения *</label>
                                <InputNumber @bind-Value="Model.YearOfBirth" 
                                            class="form-control" />
                                <ValidationMessage For="@(() => Model.YearOfBirth)" class="text-danger small" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Стаж (лет)</label>
                                <InputNumber @bind-Value="Model.Experience" 
                                            class="form-control" />
                                <ValidationMessage For="@(() => Model.Experience)" class="text-danger small" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Специализация *</label>
                                @if (_specializationsLoading)
                                {
                                    <div class="form-control">
                                        <span class="spinner-border spinner-border-sm"></span> Загрузка...
                                    </div>
                                }
                                else
                                {
                                    <InputSelect @bind-Value="Model.SpecializationId" class="form-select">
                                        <option value="">Выберите специализацию</option>
                                        @foreach (var spec in _specializations)
                                        {
                                            <option value="@spec.Id">@spec.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Model.SpecializationId)" class="text-danger small" />
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Создание...</span>
                            }
                            else
                            {
                                <span>Создать</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

<style>
    .modal {
        display: none;
    }
    
    .modal.d-block {
        display: block;
    }
</style>

@code {
    [Parameter]
    public EventCallback OnDoctorCreated { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool IsOpen { get; set; }
    private bool IsSubmitting { get; set; }
    private bool _specializationsLoading { get; set; }
    private List<SpecializationDto> _specializations = new();
    private DoctorFormModel? _model;

    private DoctorFormModel Model => _model ??= new DoctorFormModel();

    protected override void OnInitialized()
    {
       
    }

    public async Task Show()
    {
        _model = new DoctorFormModel
        {
            YearOfBirth = DateTime.Now.Year - 30,
            Experience = 0
        };
        
        await LoadSpecializations(true);
        
        IsOpen = true;
        StateHasChanged();
    }

    private async Task LoadSpecializations(bool forceRefresh = false)
    {
        _specializationsLoading = true;
        StateHasChanged();
        
        try
        {
            var url = forceRefresh ? $"api/specializations?_t={DateTime.Now.Ticks}" : "api/specializations";
            _specializations = await Http.GetFromJsonAsync<List<SpecializationDto>>(url) ?? new();
        }
        catch
        {
            _specializations = new();
        }
        finally
        {
            _specializationsLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        IsOpen = false;
        StateHasChanged();
        OnCancel.InvokeAsync();
    }

    private async Task HandleValidSubmit()
    {
        if (_model == null) return;

        IsSubmitting = true;
        StateHasChanged();

        try
        {
            var dto = new DoctorCreateDto
            {
                PassportNumber = _model.PassportNumber!,
                FullName = _model.FullName!,
                YearOfBirth = (uint)_model.YearOfBirth!.Value,
                SpecializationId = _model.SpecializationId!.Value,
                Experience = _model.Experience
            };

            var response = await Http.PostAsJsonAsync("api/doctors", dto);

            if (response.IsSuccessStatusCode)
            {
                await OnDoctorCreated.InvokeAsync();
                CloseModal();
            }
        }
        catch
        {
        }
        finally
        {
            IsSubmitting = false;
            StateHasChanged();
        }
    }

    public class DoctorFormModel
    {
        [Required(ErrorMessage = "Номер паспорта обязателен")]
        [RegularExpression(@"^\d{4}\s\d{6}$", ErrorMessage = "Не верный формат")]
        public string? PassportNumber { get; set; }

        [Required(ErrorMessage = "ФИО обязательно")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "ФИО должно быть от 2 до 100 символов")]
        public string? FullName { get; set; }

        [Required(ErrorMessage = "Год рождения обязателен")]
        [Range(1900, 2100, ErrorMessage = "Год рождения должен быть между 1900 и 2100")]
        public int? YearOfBirth { get; set; }

        [Required(ErrorMessage = "Специализация обязательна")]
        public Guid? SpecializationId { get; set; }

        [Range(0, 100, ErrorMessage = "Стаж должен быть от 0 до 100 лет")]
        public int? Experience { get; set; }
    }

    public class SpecializationDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}