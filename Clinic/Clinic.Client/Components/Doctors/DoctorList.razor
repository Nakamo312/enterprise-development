@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using Clinic.Application.Dtos.Doctors
@using Clinic.Client.Components.Shared
@inject HttpClient Http

<div class="doctors-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Врачи</h4>
        <button class="btn btn-primary" @onclick="ShowAddForm">
            <i class="bi bi-plus-circle"></i> Создать
        </button>
    </div>

    <div class="mb-3">
        <SearchPanel Placeholder="Поиск по ФИО..." 
                     SearchText="@_searchQuery"
                     SearchTextChanged="HandleSearchChanged" />
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Загрузка врачей...</p>
        </div>
    }
    else if (!_filteredDoctors.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> 
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <span>Врачи по запросу "@_searchQuery" не найдены</span>
            }
            else
            {
                <span>Врачи не найдены</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ФИО</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in _filteredDoctors)
                    {
                        <tr @onclick="() => ShowDoctorDetails(doctor)" style="cursor: pointer;">
                            <td>@doctor.FullName</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" 
                                        @onclick:stopPropagation 
                                        @onclick="() => HandleDeleteDoctor(doctor.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="mt-2 text-muted">
            <small>
                Показано @_filteredDoctors.Count из @_allDoctors.Count врачей
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <span>(отфильтровано)</span>
                }
            </small>
        </div>
    }
</div>

@if (_selectedDoctor != null)
{
    <div class="modal" style="display: block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Детали врача</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetails"></button>
                </div>
                <div class="modal-body">
                    <DoctorCard Doctor="_selectedDoctor"
                               OnDelete="HandleDeleteDoctor"
                               OnDoctorUpdated="HandleDoctorUpdated" />
                </div>
            </div>
        </div>
    </div>
}

<DoctorCreate @ref="_createModal" OnDoctorCreated="LoadDoctors" />

@code {
    private List<DoctorResponseDto> _allDoctors = new();
    private List<DoctorResponseDto> _filteredDoctors = new();
    private DoctorResponseDto? _selectedDoctor = null;
    private DoctorCreate? _createModal;
    private bool _isLoading = false;
    private string _searchQuery = string.Empty;
    
    private readonly JsonSerializerOptions _jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new JsonStringEnumConverter() }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        _isLoading = true;
        StateHasChanged();
        
        var doctors = await Http.GetFromJsonAsync<List<DoctorResponseDto>>("api/doctors", _jsonOptions);
        _allDoctors = doctors ?? new List<DoctorResponseDto>();
        
        _allDoctors = _allDoctors
            .OrderBy(d => d.FullName)
            .ToList();
        
        ApplyFilter();
        
        _isLoading = false;
        StateHasChanged();
    }

    private void HandleSearchChanged(string search)
    {
        _searchQuery = search;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _filteredDoctors = _allDoctors.ToList();
            StateHasChanged();
            return;
        }

        var searchQuery = _searchQuery.ToLowerInvariant();

        _filteredDoctors = _allDoctors
            .Where(doctor => 
                (doctor.FullName ?? "").ToLower().Contains(searchQuery))
            .ToList();
    }

    private void ShowDoctorDetails(DoctorResponseDto doctor)
    {
        _selectedDoctor = doctor;
    }

    private void CloseDetails()
    {
        _selectedDoctor = null;
    }

    private async Task HandleDeleteDoctor(Guid doctorId)
    {
        var response = await Http.DeleteAsync($"api/doctors/{doctorId}");

        if (response.IsSuccessStatusCode)
        {
            await LoadDoctors();
            CloseDetails();
        }
    }

    private async Task HandleDoctorUpdated()
    {
        await LoadDoctors();
        CloseDetails();
    }

    private void ShowAddForm()
    {
        _createModal?.Show();
    }
}