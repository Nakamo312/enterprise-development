@using MudBlazor
@using Clinic.Application.Dtos.Doctors
@using Microsoft.AspNetCore.Components

<MudCard>
    <MudCardContent>

        @if (Doctors.Count() == 0)
        {
            <div class="text-center py-4">
                <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                         Size="Size.Large"
                         Color="Color.Secondary" />

                <MudText Typo="Typo.h6" Class="mt-2">
                    Нет врачей
                </MudText>
            </div>
        }
        else
        {
            <MudTable Items="Doctors"
                      Hover="true"
                      Dense="true"
                      Breakpoint="Breakpoint.Sm">

                <HeaderContent>
                    <MudTh>ФИО</MudTh>
                    <MudTh>Паспорт</MudTh>
                    <MudTh>Специализация</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="ФИО">@context.FullName</MudTd>
                    <MudTd DataLabel="Паспорт">@context.PassportNumber</MudTd>
                    <MudTd DataLabel="Специализация">
                        @(_specializations.TryGetValue(context.SpecializationId, out var name) ? name : "Неизвестно")
                    </MudTd>
                    <MudTd Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="() => OnDoctorSelected.InvokeAsync(context)" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => OnDeleteRequested.InvokeAsync(context.PassportNumber)" />
                    </MudTd>
                </RowTemplate>

            </MudTable>
        }

    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DoctorResponseDto> Doctors { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback<DoctorResponseDto> OnDoctorSelected { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnDeleteRequested { get; set; }

    [Parameter]
    public Dictionary<Guid, string> _specializations { get; set; } = new();
}
