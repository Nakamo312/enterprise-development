@using MudBlazor

<MudCard>
    <MudCardContent>
        <div class="text-center py-8">
            <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />

            <MudText Typo="Typo.h6" Class="mb-2">@Title</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@Message</MudText>

            @if (!string.IsNullOrEmpty(ButtonText))
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OnClick.InvokeAsync())">
                    @ButtonText
                </MudButton>
            }
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Info;
    [Parameter] public string? ButtonText { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}