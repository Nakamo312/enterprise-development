@using MudBlazor
@using Microsoft.AspNetCore.Components

<MudPaper Class="pa-4" Elevation="1">
    <MudGrid Spacing="2" Class="d-flex align-items-center">

        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudTextField T="string"
                          Value="@_search"
                          Placeholder="Поиск по кабинету"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Immediate="true"
                          ValueChanged="OnSearchChanged" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudDatePicker Date="@_selectedDate"
                           Label="Дата"
                           Margin="Margin.Dense"
                           DateChanged="OnDateChanged" />
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudCheckBox T="bool"
                         Value="@_onlyRepeated"
                         Label="Только повторные"
                         TriState="false"
                         ValueChanged="OnOnlyRepeatedChanged" />
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetFilters">
                Сбросить фильтры
            </MudButton>
        </MudItem>

    </MudGrid>
</MudPaper>

@code {
    private string _search = string.Empty;
    private DateTime? _selectedDate;
    private bool _onlyRepeated;

    [Parameter] public EventCallback OnChanged { get; set; }

    public string Search => _search;
    public DateTime? SelectedDate => _selectedDate;
    public bool OnlyRepeated => _onlyRepeated;

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await InvokeChanged();
    }

    private async Task OnDateChanged(DateTime? value)
    {
        _selectedDate = value;
        await InvokeChanged();
    }

    private async Task OnOnlyRepeatedChanged(bool value)
    {
        _onlyRepeated = value;
        await InvokeChanged();
    }

    private async Task ResetFilters()
    {
        _search = string.Empty;
        _selectedDate = null;
        _onlyRepeated = false;
        await InvokeChanged();
    }

    private async Task InvokeChanged()
    {
        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }
}
