@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using Clinic.Application.Dtos.Appointments
@using Clinic.Client.Components.Shared
@inject HttpClient Http

<div class="appointments-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Записи на приём</h4>
        <button class="btn btn-primary" @onclick="ShowAddForm">
            <i class="bi bi-plus-circle"></i> Создать
        </button>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <SearchPanel Placeholder="Поиск по кабинету..." 
                         SearchText="@_searchQuery"
                         SearchTextChanged="@((search) => { _searchQuery = search; ApplyFilter(); })" />
        </div>
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-calendar"></i>
                </span>
                <input type="date" class="form-control" 
                       value="@_dateFilterString" 
                       @onchange="@((e) => { _dateFilterString = e.Value?.ToString() ?? ""; ApplyFilter(); })" />
                @if (!string.IsNullOrEmpty(_dateFilterString))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearDateFilter">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Загрузка записей...</p>
        </div>
    }
    else if (!_filteredAppointments.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> 
            @if (!string.IsNullOrEmpty(_searchQuery) || !string.IsNullOrEmpty(_dateFilterString))
            {
                <span>Записи по заданным фильтрам не найдены</span>
            }
            else
            {
                <span>Записи на приём отсутствуют</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Дата и время</th>
                        <th>Кабинет</th>
                        <th>Повторный</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in _filteredAppointments)
                    {
                        <tr @onclick="() => ShowAppointmentDetails(appointment)" style="cursor: pointer;">
                            <td>@appointment.DateTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@appointment.RoomNumber</td>
                            <td>
                                @if (appointment.IsRepeated)
                                {
                                    <span class="badge bg-warning">Да</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Нет</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" 
                                        @onclick:stopPropagation 
                                        @onclick="() => HandleDeleteAppointment(appointment.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="mt-2 text-muted">
            <small>
                Показано @_filteredAppointments.Count из @_allAppointments.Count записей
                @if (!string.IsNullOrEmpty(_searchQuery) || !string.IsNullOrEmpty(_dateFilterString))
                {
                    <span>(отфильтровано)</span>
                }
            </small>
        </div>
    }
</div>

@if (_selectedAppointment != null)
{
    <div class="modal" style="display: block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Детали записи</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetails"></button>
                </div>
                <div class="modal-body">
                    <AppointmentCard Appointment="_selectedAppointment"
                                    OnDelete="HandleDeleteAppointment"
                                    OnAppointmentUpdated="HandleAppointmentUpdated" />
                </div>
            </div>
        </div>
    </div>
}

<AppointmentCreate @ref="_createModal" OnAppointmentCreated="LoadAppointments" />

@code {
    private List<AppointmentResponseDto> _allAppointments = new();
    private List<AppointmentResponseDto> _filteredAppointments = new();
    private AppointmentResponseDto? _selectedAppointment = null;
    private AppointmentCreate? _createModal;
    private bool _isLoading = false;
    private string _searchQuery = string.Empty;
    private string _dateFilterString = string.Empty;
    
    private readonly JsonSerializerOptions _jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new JsonStringEnumConverter() }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        _isLoading = true;
        StateHasChanged();
        
        try
        {
            var appointments = await Http.GetFromJsonAsync<List<AppointmentResponseDto>>("api/appointments", _jsonOptions);
            _allAppointments = appointments ?? new List<AppointmentResponseDto>();
            
            _allAppointments = _allAppointments
                .OrderByDescending(a => a.DateTime)
                .ToList();
            
            ApplyFilter();
        }
        catch
        {
            _allAppointments = new List<AppointmentResponseDto>();
            _filteredAppointments = new List<AppointmentResponseDto>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) && string.IsNullOrWhiteSpace(_dateFilterString))
        {
            _filteredAppointments = _allAppointments.ToList();
            return;
        }

        var query = _allAppointments.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var searchQuery = _searchQuery.ToLowerInvariant();
            query = query.Where(a =>
                (a.RoomNumber ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_dateFilterString))
        {
            if (DateOnly.TryParse(_dateFilterString, out var filterDate))
            {
                var filterDateTime = new DateTime(filterDate.Year, filterDate.Month, filterDate.Day);
                query = query.Where(a => a.DateTime.Date == filterDateTime);
            }
        }

        _filteredAppointments = query.ToList();
    }

    private void ClearDateFilter()
    {
        _dateFilterString = string.Empty;
        ApplyFilter();
    }

    private void ShowAppointmentDetails(AppointmentResponseDto appointment)
    {
        _selectedAppointment = appointment;
    }

    private void CloseDetails()
    {
        _selectedAppointment = null;
    }

    private async Task HandleDeleteAppointment(Guid appointmentId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/appointments/{appointmentId}");

            if (response.IsSuccessStatusCode)
            {
                await LoadAppointments();
                CloseDetails();
            }
        }
        catch
        {
        }
    }

    private async Task HandleAppointmentUpdated()
    {
        await LoadAppointments();
        CloseDetails();
    }

    private void ShowAddForm()
    {
        _createModal?.Show();
    }
}