@using MudBlazor
@using Clinic.Application.Dtos.Appointments

<MudCard>
    <MudCardContent>

        @if (Appointments.Count() == 0)
        {
            <div class="text-center py-4">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy"
                         Size="Size.Large"
                         Color="Color.Secondary" />

                <MudText Typo="Typo.h6" Class="mt-2">
                    Нет записей на приём
                </MudText>
            </div>
        }
        else
        {
            <MudTable Items="Appointments"
                      Hover="true"
                      Dense="true"
                      Breakpoint="Breakpoint.Sm">

                <HeaderContent>
                    <MudTh>Дата и время</MudTh>
                    <MudTh>Пациент</MudTh>
                    <MudTh>Врач</MudTh>
                    <MudTh>Кабинет</MudTh>
                    <MudTh>Повторный</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Дата и время">
                        @context.DateTime.ToString("dd.MM.yyyy HH:mm")
                    </MudTd>

                    <MudTd DataLabel="Пациент">
                        @PatientNames.GetValueOrDefault(context.PatientId, "Неизвестно")
                    </MudTd>

                    <MudTd DataLabel="Врач">
                        @DoctorNames.GetValueOrDefault(context.DoctorId, "Неизвестно")
                    </MudTd>

                    <MudTd DataLabel="Кабинет">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">
                            @context.RoomNumber
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Повторный">
                        <MudChip T="string" Color="@(context.IsRepeated ? Color.Warning : Color.Default)"
                                 Size="Size.Small">
                            @(context.IsRepeated ? "Да" : "Нет")
                        </MudChip>
                    </MudTd>

                    <MudTd Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="() => OnAppointmentSelected.InvokeAsync(context)" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => OnDeleteRequested.InvokeAsync(context.Id)" />
                    </MudTd>
                </RowTemplate>

            </MudTable>
        }

    </MudCardContent>
</MudCard>

@code {

    [Parameter, EditorRequired]
    public IReadOnlyList<AppointmentResponseDto> Appointments { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<Guid, string> PatientNames { get; set; }
        = new Dictionary<Guid, string>();

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<Guid, string> DoctorNames { get; set; }
        = new Dictionary<Guid, string>();

    [Parameter, EditorRequired]
    public EventCallback<AppointmentResponseDto> OnAppointmentSelected { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnDeleteRequested { get; set; }
}
