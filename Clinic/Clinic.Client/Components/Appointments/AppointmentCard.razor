@using System.Net.Http.Json
@using Clinic.Application.Dtos.Appointments
@using Clinic.Application.Dtos.Doctors
@using Clinic.Application.Dtos.Patients
@inject HttpClient Http

<div class="card mb-3 appointment-card">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
            <i class="bi bi-calendar-check me-1"></i>
            Запись на @Appointment.DateTime.ToString("dd.MM.yyyy HH:mm")
        </h6>
        <div class="d-flex flex-nowrap">
            @if (!_isEditing)
            {
                <button class="btn btn-sm btn-light me-1" @onclick="StartEditing">
                    <i class="bi bi-pencil"></i> Редактировать
                </button>
                <button class="btn btn-sm btn-danger" @onclick="() => OnDelete.InvokeAsync(Appointment.Id)">
                    <i class="bi bi-trash"></i> Удалить
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-success me-1" @onclick="SaveChanges">
                    <i class="bi bi-check"></i> Сохранить
                </button>
                <button class="btn btn-sm btn-secondary" @onclick="CancelEditing">
                    <i class="bi bi-x"></i> Отмена
                </button>
            }
        </div>
    </div>

    <div class="card-body">
        <table class="table appointment-table mb-0">
            <tbody>
                <tr>
                    <td width="40%"><strong>Дата и время:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @Appointment.DateTime.ToString("dd.MM.yyyy HH:mm")
                        }
                        else
                        {
                            <input type="datetime-local" 
                                   value="@_editDateTimeLocal"
                                   @onchange="@((e) => _editDateTimeLocal = e.Value?.ToString() ?? string.Empty)"
                                   class="form-control form-control-sm" />
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Кабинет:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @Appointment.RoomNumber
                        }
                        else
                        {
                            <input @bind="_editAppointment!.RoomNumber" 
                                   class="form-control form-control-sm" 
                                   maxlength="10" />
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Повторный визит:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" 
                                       checked="@Appointment.IsRepeated" disabled />
                                <label class="form-check-label">
                                    @(Appointment.IsRepeated ? "Да" : "Нет")
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" 
                                       @bind="_editAppointment!.IsRepeated" />
                                <label class="form-check-label">
                                    @(_editAppointment!.IsRepeated ? "Да" : "Нет")
                                </label>
                            </div>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Пациент:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @(_patientName ?? "Загрузка...")
                        }
                        else
                        {
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Введите ФИО пациента..."
                                       @bind="_patientSearch"
                                       @bind:event="oninput"
                                       @onfocus="() => _showPatientSuggestions = true"
                                       @onblur="() => HidePatientSuggestions()" />
                                
                                @if (_showPatientSuggestions && !string.IsNullOrEmpty(_patientSearch) && _filteredPatients.Any())
                                {
                                    <div class="dropdown-menu show w-100" style="position: absolute; z-index: 1000; top: 100%; left: 0; right: 0;">
                                        @foreach (var patient in _filteredPatients.Take(10))
                                        {
                                            <button class="dropdown-item" type="button" 
                                                    @onclick="@(() => SelectPatient(patient))"
                                                    @onmousedown:preventDefault>
                                                @patient.FullName (@patient.PassportNumber)
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Врач:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @if (_doctorName != null && _doctorSpecialization != null)
                            {
                                <div>
                                    <div>@_doctorName</div>
                                    <small class="text-muted">@_doctorSpecialization</small>
                                </div>
                            }
                            else
                            {
                                <span>Загрузка...</span>
                            }
                        }
                        else
                        {
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Введите ФИО врача..."
                                       @bind="_doctorSearch"
                                       @bind:event="oninput"
                                       @onfocus="() => _showDoctorSuggestions = true"
                                       @onblur="() => HideDoctorSuggestions()" />
                                
                                @if (_showDoctorSuggestions && !string.IsNullOrEmpty(_doctorSearch) && _filteredDoctors.Any())
                                {
                                    <div class="dropdown-menu show w-100" style="position: absolute; z-index: 1000; top: 100%; left: 0; right: 0;">
                                        @foreach (var doctor in _filteredDoctors.Take(10))
                                        {
                                            <button class="dropdown-item" type="button" 
                                                    @onclick="@(() => SelectDoctor(doctor))"
                                                    @onmousedown:preventDefault>
                                                @doctor.FullName
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger m-0 rounded-0">
            @_errorMessage
        </div>
    }
</div>

<style>
    .appointment-card {
        display: flex;
        flex-direction: column;
    }
    
    .appointment-table {
        border-collapse: collapse;
    }
    
    .appointment-table tr {
        border-bottom: 1px solid #f0f0f0;
    }
    
    .appointment-table tr:last-child {
        border-bottom: none;
    }
    
    .appointment-table td {
        padding: 8px 0;
        vertical-align: top;
    }
    
    .appointment-table td:first-child {
        padding-right: 16px;
    }
    
    .form-check-input:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .dropdown-menu {
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    .dropdown-item {
        white-space: normal;
        word-wrap: break-word;
        cursor: pointer;
        padding: 8px 16px;
    }
    
    .dropdown-item:hover {
        background-color: #f8f9fa;
    }
</style>

@code {
    [Parameter]
    public required AppointmentResponseDto Appointment { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    [Parameter]
    public EventCallback OnAppointmentUpdated { get; set; }

    private bool _isEditing = false;
    private bool _showPatientSuggestions = false;
    private bool _showDoctorSuggestions = false;
    private AppointmentCreateDto? _editAppointment;
    private string _editDateTimeLocal = string.Empty;
    private string? _errorMessage;
    
    private string? _patientName;
    private string? _doctorName;
    private string? _doctorSpecialization;
    
    private List<PatientDto> _patients = new();
    private List<DoctorDto> _doctors = new();
    
    private string _patientSearch = string.Empty;
    private string _doctorSearch = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatientName();
        await LoadDoctorName();
    }

    private async Task LoadPatientName()
    {
        var patient = await Http.GetFromJsonAsync<PatientDto>($"api/patients/{Appointment.PatientId}");
        _patientName = patient?.FullName ?? "Неизвестно";
    }

    private async Task LoadDoctorName()
    {
        var doctor = await Http.GetFromJsonAsync<DoctorDto>($"api/doctors/{Appointment.DoctorId}");
        _doctorName = doctor?.FullName ?? "Неизвестно";
        
        if (doctor != null && doctor.SpecializationId != Guid.Empty)
        {
            var specialization = await Http.GetFromJsonAsync<SpecializationDto>($"api/specializations/{doctor.SpecializationId}");
            _doctorSpecialization = specialization?.Name ?? "";
        }
    }

    private async void StartEditing()
    {
        _isEditing = true;
        _errorMessage = null;
        _showPatientSuggestions = false;
        _showDoctorSuggestions = false;
        
        _editAppointment = new AppointmentCreateDto
        {
            DateTime = Appointment.DateTime,
            RoomNumber = Appointment.RoomNumber,
            IsRepeated = Appointment.IsRepeated,
            PatientId = Appointment.PatientId,
            DoctorId = Appointment.DoctorId
        };
        
        _editDateTimeLocal = Appointment.DateTime.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
        
        await LoadPatients();
        await LoadDoctors();
        
        _patientSearch = _patientName ?? string.Empty;
        _doctorSearch = _doctorName ?? string.Empty;
    }

    private async Task LoadPatients()
    {
        _patients = await Http.GetFromJsonAsync<List<PatientDto>>("api/patients") ?? new();
    }

    private async Task LoadDoctors()
    {
        _doctors = await Http.GetFromJsonAsync<List<DoctorDto>>("api/doctors") ?? new();
    }

    private IEnumerable<PatientDto> _filteredPatients
    {
        get
        {
            if (string.IsNullOrEmpty(_patientSearch))
                return Enumerable.Empty<PatientDto>();
            
            return _patients.Where(p => 
                (p.FullName ?? "").Contains(_patientSearch, StringComparison.OrdinalIgnoreCase) ||
                (p.PassportNumber ?? "").Contains(_patientSearch, StringComparison.OrdinalIgnoreCase))
                .Take(10);
        }
    }
    
    private IEnumerable<DoctorDto> _filteredDoctors
    {
        get
        {
            if (string.IsNullOrEmpty(_doctorSearch))
                return Enumerable.Empty<DoctorDto>();
            
            return _doctors.Where(d => 
                (d.FullName ?? "").Contains(_doctorSearch, StringComparison.OrdinalIgnoreCase))
                .Take(10);
        }
    }
    
    private void SelectPatient(PatientDto patient)
    {
        if (_editAppointment != null)
        {
            _editAppointment.PatientId = patient.Id;
            _patientSearch = patient.FullName;
            _patientName = patient.FullName;
            _showPatientSuggestions = false;
        }
    }
    
    private void SelectDoctor(DoctorDto doctor)
    {
        if (_editAppointment != null)
        {
            _editAppointment.DoctorId = doctor.Id;
            _doctorSearch = doctor.FullName;
            _doctorName = doctor.FullName;
            _showDoctorSuggestions = false;
            
            if (doctor.SpecializationId != Guid.Empty)
            {
                _ = LoadDoctorSpecialization(doctor.SpecializationId);
            }
        }
    }
    
    private async Task LoadDoctorSpecialization(Guid specializationId)
    {
        var specialization = await Http.GetFromJsonAsync<SpecializationDto>($"api/specializations/{specializationId}");
        _doctorSpecialization = specialization?.Name ?? string.Empty;
    }

    private async void HidePatientSuggestions()
    {
        await Task.Delay(200);
        _showPatientSuggestions = false;
        StateHasChanged();
    }

    private async void HideDoctorSuggestions()
    {
        await Task.Delay(200);
        _showDoctorSuggestions = false;
        StateHasChanged();
    }

    private async Task SaveChanges()
    {
        if (_editAppointment == null) return;

        if (DateTime.TryParse(_editDateTimeLocal, out var localDateTime))
        {
            _editAppointment.DateTime = DateTime.SpecifyKind(localDateTime, DateTimeKind.Local).ToUniversalTime();
        }
        else
        {
            _errorMessage = "Некорректная дата и время";
            return;
        }

        _errorMessage = null;

        var response = await Http.PutAsJsonAsync($"api/appointments/{Appointment.Id}", _editAppointment);

        if (response.IsSuccessStatusCode)
        {
            _isEditing = false;
            await OnAppointmentUpdated.InvokeAsync();
        }
        else
        {
            _errorMessage = $"Ошибка при сохранении записи: {response.StatusCode}";
        }
    }

    private void CancelEditing()
    {
        _isEditing = false;
        _editAppointment = null;
        _editDateTimeLocal = string.Empty;
        _errorMessage = null;
        _patientSearch = string.Empty;
        _doctorSearch = string.Empty;
        _showPatientSuggestions = false;
        _showDoctorSuggestions = false;
    }

    public class PatientDto
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string PassportNumber { get; set; } = string.Empty;
    }

    public class DoctorDto
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = string.Empty;
        public Guid SpecializationId { get; set; }
    }

    public class SpecializationDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}