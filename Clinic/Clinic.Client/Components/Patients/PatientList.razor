@using Clinic.Application.Dtos.Patients
@using Clinic.Client.Components.Shared
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http

<div class="patients-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Пациенты</h4>
        <button class="btn btn-primary" @onclick="ShowAddForm">
            <i class="bi bi-plus-circle"></i> Создать
        </button>
    </div>

    <div class="mb-3">
        <SearchPanel Placeholder="Поиск по ФИО..." 
                     SearchText="@_searchQuery"
                     SearchTextChanged="HandleSearchChanged" />
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Загрузка пациентов...</p>
        </div>
    }
    else if (!_filteredPatients.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> 
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <span>Пациенты по запросу "@_searchQuery" не найдены</span>
            }
            else
            {
                <span>Пациенты не найдены</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ФИО</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in _filteredPatients)
                    {
                        <tr @onclick="() => ShowPatientDetails(patient)" style="cursor: pointer;">
                            <td>@patient.FullName</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" 
                                        @onclick:stopPropagation 
                                        @onclick="() => HandleDeletePatient(patient.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="mt-2 text-muted">
            <small>
                Показано @_filteredPatients.Count из @_allPatients.Count пациентов
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <span>(отфильтровано)</span>
                }
            </small>
        </div>
    }
</div>

@if (_selectedPatient != null)
{
    <div class="modal" style="display: block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Детали пациента</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetails"></button>
                </div>
                <div class="modal-body">
                    <PatientCard Patient="_selectedPatient"
                                 OnDelete="HandleDeletePatient"
                                 OnPatientUpdated="HandlePatientUpdated" />
                </div>
            </div>
        </div>
    </div>
}

<PatientCreate @ref="_createModal" OnPatientCreated="LoadPatients" />

@code {
    @using Clinic.Domain.Enums

    private List<PatientResponseDto> _allPatients = new();
    private List<PatientResponseDto> _filteredPatients = new();
    private PatientResponseDto? _selectedPatient = null;
    private PatientCreate? _createModal;
    private bool _isLoading = false;
    private string _searchQuery = string.Empty;
    
    private readonly JsonSerializerOptions _jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new JsonStringEnumConverter() }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        _isLoading = true;
        StateHasChanged();
        
        var patients = await Http.GetFromJsonAsync<List<PatientResponseDto>>("api/patients", _jsonOptions);
        _allPatients = patients ?? new List<PatientResponseDto>();
        
        _allPatients = _allPatients
            .OrderBy(p => p.FullName)
            .ToList();
        
        ApplyFilter();
        
        _isLoading = false;
        StateHasChanged();
    }

    private void HandleSearchChanged(string search)
    {
        _searchQuery = search;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _filteredPatients = _allPatients.ToList();
            StateHasChanged();
            return;
        }

        var searchQuery = _searchQuery.ToLowerInvariant();

        _filteredPatients = _allPatients
            .Where(patient => 
                (patient.FullName ?? "").ToLower().Contains(searchQuery))
            .ToList();
    }

    private void ShowPatientDetails(PatientResponseDto patient)
    {
        _selectedPatient = patient;
    }

    private void CloseDetails()
    {
        _selectedPatient = null;
    }

    private async Task HandleDeletePatient(Guid patientId)
    {
        var response = await Http.DeleteAsync($"api/patients/{patientId}");

        if (response.IsSuccessStatusCode)
        {
            await LoadPatients();
            CloseDetails();
        }
    }

    private async Task HandlePatientUpdated()
    {
        await LoadPatients();
        CloseDetails();
    }

    private void ShowAddForm()
    {
        _createModal?.Show();
    }
}