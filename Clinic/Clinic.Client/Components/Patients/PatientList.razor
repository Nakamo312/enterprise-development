@using MudBlazor
@using Clinic.Domain.Models
@using Microsoft.AspNetCore.Components

<MudCard>
    <MudCardContent>

        @if (Patients.Count() == 0)
        {
            <div class="text-center py-4">
                <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                         Size="Size.Large"
                         Color="Color.Secondary" />

                <MudText Typo="Typo.h6" Class="mt-2">
                    Нет пациентов
                </MudText>
            </div>
        }
        else
        {
            <MudTable Items="Patients"
                      Hover="true"
                      Dense="true"
                      Breakpoint="Breakpoint.Sm">

                <HeaderContent>
                    <MudTh>ФИО</MudTh>
                    <MudTh>Паспорт</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="ФИО">@context.FullName</MudTd>
                    <MudTd DataLabel="Паспорт">@context.PassportNumber</MudTd>

                    <MudTd Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="() => OnPatientSelected.InvokeAsync(context)" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => OnDeleteRequested.InvokeAsync(context.Id)" />
                    </MudTd>
                </RowTemplate>

            </MudTable>
        }

    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Patient> Patients { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback<Patient> OnPatientSelected { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnDeleteRequested { get; set; }
}
