@using System.ComponentModel.DataAnnotations
@inject HttpClient Http

<div class="modal @(IsOpen ? "d-block" : "d-none")" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                               <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>

            <EditForm Model="Model" OnValidSubmit="HandleValidSubmit" FormName="PatientCreate">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger m-3" />

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="passportNumber" class="form-label">Паспорт *</label>
                            <InputText id="passportNumber" @bind-Value="Model!.PassportNumber" 
                                      class="form-control" placeholder="1234 567890" />
                            <ValidationMessage For="@(() => Model!.PassportNumber)" class="text-danger small" />
                        </div>

                        <div class="col-md-6">
                            <label for="fullName" class="form-label">ФИО *</label>
                            <InputText id="fullName" @bind-Value="Model!.FullName" 
                                      class="form-control" />
                            <ValidationMessage For="@(() => Model!.FullName)" class="text-danger small" />
                        </div>

                        <div class="col-md-6">
                            <label for="gender" class="form-label">Пол *</label>
                            <InputSelect id="gender" @bind-Value="Model!.Gender" class="form-select">
                                <option value="Male">Мужской</option>
                                <option value="Female">Женский</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => Model!.Gender)" class="text-danger small" />
                        </div>

                        <div class="col-md-6">
                            <label for="dateOfBirth" class="form-label">Дата рождения *</label>
                            <InputDate id="dateOfBirth" @bind-Value="DateOfBirth" 
                                      class="form-control" max="@DateTime.Today" />
                            <ValidationMessage For="@(() => Model!.DateOfBirth)" class="text-danger small" />
                        </div>

                        <div class="col-12">
                            <label for="address" class="form-label">Адрес *</label>
                            <InputTextArea id="address" @bind-Value="Model!.Address" 
                                          class="form-control" rows="2" 
                                          placeholder="Город, улица, дом, квартира" />
                            <ValidationMessage For="@(() => Model!.Address)" class="text-danger small" />
                        </div>

                        <div class="col-md-6">
                            <label for="bloodGroup" class="form-label">Группа крови *</label>
                            <InputSelect id="bloodGroup" @bind-Value="Model!.BloodGroup" class="form-select">
                                <option value="O">I (O)</option>
                                <option value="A">II (A)</option>
                                <option value="B">III (B)</option>
                                <option value="AB">IV (AB)</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => Model!.BloodGroup)" class="text-danger small" />
                        </div>

                        <div class="col-md-6">
                            <label for="rhFactor" class="form-label">Резус-фактор *</label>
                            <InputSelect id="rhFactor" @bind-Value="Model!.RhFactor" class="form-select">
                                <option value="P">+</option>
                                <option value="N">-</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => Model!.RhFactor)" class="text-danger small" />
                        </div>

                        <div class="col-12">
                            <label for="contactPhone" class="form-label">Телефон</label>
                            <InputText id="contactPhone" @bind-Value="Model!.ContactPhone" 
                                      class="form-control" placeholder="+7 (999) 123-45-67" />
                            <ValidationMessage For="@(() => Model!.ContactPhone)" class="text-danger small" />
                            <div class="form-text">Необязательное поле</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                    <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Создание...</span>
                        }
                        else
                        {
                            <span>Создать</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .modal {
        display: none;
    }
    
    .modal.d-block {
        display: block;
    }
</style>

@code {
    [Parameter]
    public EventCallback OnPatientCreated { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool IsOpen { get; set; }
    private bool IsSubmitting { get; set; }

    [SupplyParameterFromForm]
    private PatientFormModel? Model { get; set; }

    private DateTime? DateOfBirth
    {
        get => Model?.DateOfBirth.HasValue == true 
            ? Model.DateOfBirth.Value.ToDateTime(TimeOnly.MinValue) 
            : null;
        set
        {
            if (Model != null && value.HasValue)
            {
                Model.DateOfBirth = DateOnly.FromDateTime(value.Value);
            }
        }
    }

    protected override void OnInitialized()
    {
        Model ??= new PatientFormModel
        {
            DateOfBirth = DateOnly.FromDateTime(DateTime.Today.AddYears(-30))
        };
    }

    public void Show()
    {
        Model = new PatientFormModel
        {
            DateOfBirth = DateOnly.FromDateTime(DateTime.Today.AddYears(-30))
        };
        IsOpen = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        IsOpen = false;
        StateHasChanged();
        OnCancel.InvokeAsync();
    }

    private async Task HandleValidSubmit()
    {
        IsSubmitting = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/patients", Model);

            if (response.IsSuccessStatusCode)
            {
                await OnPatientCreated.InvokeAsync();
                CloseModal();
            }
        }
        catch
        {
        }
        finally
        {
            IsSubmitting = false;
            StateHasChanged();
        }
    }

    public class PatientFormModel
    {
        [Required(ErrorMessage = "Номер паспорта обязателен")]
        [RegularExpression(@"^\d{4}\s\d{6}$", ErrorMessage = "Не верный формат")]
        public string PassportNumber { get; set; } = string.Empty;

        [Required(ErrorMessage = "ФИО обязательно")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "ФИО должно быть от 2 до 100 символов")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Пол обязателен")]
        public string Gender { get; set; } = string.Empty;

        [Required(ErrorMessage = "Дата рождения обязательна")]
        public DateOnly? DateOfBirth { get; set; }


        [StringLength(200, ErrorMessage = "Адрес не должен превышать 200 символов")]
        public string Address { get; set; } = string.Empty;

        [Required(ErrorMessage = "Группа крови обязательна")]
        public string BloodGroup { get; set; } = string.Empty;

        [Required(ErrorMessage = "Резус-фактор обязателен")]
        public string RhFactor { get; set; } = string.Empty;

        [RegularExpression(@"^(\+7|8)[\s]?(?:(?:\(\d{3}\)|\d{3}))(?:(?:[\s\-]?\d{3})(?:[\s\-]?\d{4}|(?:[\s\-]?\d{2}){2}))$", 
            ErrorMessage = "Не верный формат")]
        [StringLength(20, ErrorMessage = "Телефон не должен превышать 20 символов")]
        public string? ContactPhone { get; set; }
    }
}