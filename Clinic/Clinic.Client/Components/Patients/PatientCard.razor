@using Clinic.Application.Dtos.Patients
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<div class="card mb-3 patient-card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <div class="d-flex flex-nowrap">
            @if (!_isEditing)
            {
                <button class="btn btn-sm btn-light me-1" @onclick="StartEditing">
                    <i class="bi bi-pencil"></i> Редактировать
                </button>
                <button class="btn btn-sm btn-danger" @onclick="() => OnDelete.InvokeAsync(Patient.Id)">
                    <i class="bi bi-trash"></i> Удалить
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-success me-1" @onclick="SaveChanges">
                    <i class="bi bi-check"></i> Сохранить
                </button>
                <button class="btn btn-sm btn-secondary" @onclick="CancelEditing">
                    <i class="bi bi-x"></i> Отмена
                </button>
            }
        </div>
    </div>

    <div class="card-body">
        <table class="table patient-table mb-0">
            <tbody>
                <tr>
                    <td width="30%"><strong>Паспорт:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @Patient.PassportNumber
                        }
                        else
                        {
                            <input @bind="_editPatient!.PassportNumber" class="form-control form-control-sm" />
                            @if (_errors.ContainsKey("PassportNumber"))
                            {
                                <div class="text-danger small mt-1">@_errors["PassportNumber"]</div>
                            }
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>ФИО:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @Patient.FullName
                        }
                        else
                        {
                            <input @bind="_editPatient!.FullName" class="form-control form-control-sm" />
                            @if (_errors.ContainsKey("FullName"))
                            {
                                <div class="text-danger small mt-1">@_errors["FullName"]</div>
                            }
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Пол:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @GetGenderDisplay(Patient.Gender.ToString())
                        }
                        else
                        {
                            <select @bind="_editPatient!.Gender" class="form-select form-select-sm">
                                <option value="Male">Мужской</option>
                                <option value="Female">Женский</option>
                            </select>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Дата рождения:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @Patient.DateOfBirth.ToString("dd.MM.yyyy")
                        }
                        else
                        {
                            <input type="date" @bind="_editPatient!.DateOfBirth" 
                                   class="form-control form-control-sm" 
                                   @bind:format="yyyy-MM-dd" />
                            @if (_errors.ContainsKey("DateOfBirth"))
                            {
                                <div class="text-danger small mt-1">@_errors["DateOfBirth"]</div>
                            }
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Адрес:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @Patient.Address
                        }
                        else
                        {
                            <input @bind="_editPatient!.Address" class="form-control form-control-sm" />
                            @if (_errors.ContainsKey("Address"))
                            {
                                <div class="text-danger small mt-1">@_errors["Address"]</div>
                            }
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Группа крови:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @GetBloodGroupDisplay(Patient.BloodGroup.ToString()) @GetRhFactorDisplay(Patient.RhFactor.ToString())
                        }
                        else
                        {
                            <div class="row g-2">
                                <div class="col">
                                    <select @bind="_editPatient!.BloodGroup" class="form-select form-select-sm">
                                        <option value="O">I (O)</option>
                                        <option value="A">II (A)</option>
                                        <option value="B">III (B)</option>
                                        <option value="AB">IV (AB)</option>
                                    </select>
                                </div>
                                <div class="col">
                                    <select @bind="_editPatient!.RhFactor" class="form-select form-select-sm">
                                        <option value="P">+</option>
                                        <option value="N">-</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Телефон:</strong></td>
                    <td>
                        @if (!_isEditing)
                        {
                            @(Patient.ContactPhone ?? "не указан")
                        }
                        else
                        {
                            <input @bind="_editPatient!.ContactPhone" class="form-control form-control-sm"
                                   placeholder="+7 (XXX) XXX-XX-XX" />
                            @if (_errors.ContainsKey("ContactPhone"))
                            {
                                <div class="text-danger small mt-1">@_errors["ContactPhone"]</div>
                            }
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger m-0 rounded-0">
            @_errorMessage
        </div>
    }
</div>

<style>
    .patient-card {
        height: 400px;
        display: flex;
        flex-direction: column;
    }
    
    .patient-card .card-body {
        flex: 1;
        overflow-y: auto;
    }
    
    .patient-table {
        border-collapse: collapse;
    }
    
    .patient-table tr {
        border-bottom: 1px solid #f0f0f0;
    }
    
    .patient-table tr:last-child {
        border-bottom: none;
    }
    
    .patient-table td {
        padding: 8px 0;
    }
    
    .patient-table td:first-child {
        padding-right: 16px;
        vertical-align: top;
    }
</style>

@code {
    [Parameter]
    public required PatientResponseDto Patient { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    [Parameter]
    public EventCallback OnPatientUpdated { get; set; }

    private bool _isEditing = false;
    private PatientUpdateDto? _editPatient;
    private string? _errorMessage;
    private Dictionary<string, string> _errors = new();

    private string GetGenderDisplay(string gender)
    {
        return gender switch
        {
            "Male" => "Мужской",
            "Female" => "Женский",
            _ => gender
        };
    }

    private string GetBloodGroupDisplay(string bloodGroup)
    {
        return bloodGroup switch
        {
            "O" => "I (O)",
            "A" => "II (A)",
            "B" => "III (B)",
            "AB" => "IV (AB)",
            _ => bloodGroup
        };
    }

    private string GetRhFactorDisplay(string rhFactor)
    {
        return rhFactor switch
        {
            "P" => "+",
            "N" => "-",
            _ => rhFactor
        };
    }

    private void StartEditing()
    {
        _isEditing = true;
        _errorMessage = null;
        _errors.Clear();
        
        _editPatient = new PatientUpdateDto
        {
            PassportNumber = Patient.PassportNumber,
            FullName = Patient.FullName,
            Gender = Patient.Gender,
            DateOfBirth = Patient.DateOfBirth,
            Address = Patient.Address,
            BloodGroup = Patient.BloodGroup,
            RhFactor = Patient.RhFactor,
            ContactPhone = Patient.ContactPhone
        };
    }

    private async Task SaveChanges()
    {
        if (_editPatient == null) return;

        _errorMessage = null;
        _errors.Clear();

        try
        {
            var response = await Http.PutAsJsonAsync($"api/patients/{Patient.Id}", _editPatient);

            if (response.IsSuccessStatusCode)
            {
                _isEditing = false;
                await OnPatientUpdated.InvokeAsync();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                
                if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    ParseValidationErrors(errorContent);
                }
                else
                {
                    _errorMessage = "Ошибка при сохранении данных";
                }
            }
        }
        catch
        {
            _errorMessage = "Ошибка соединения";
        }
    }

    private void ParseValidationErrors(string errorJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(errorJson);
            var root = doc.RootElement;
            
            if (root.TryGetProperty("errors", out var errors))
            {
                foreach (var error in errors.EnumerateObject())
                {
                    var fieldName = error.Name;
                    var errorMessage = error.Value[0].GetString();
                    
                    if (!string.IsNullOrEmpty(errorMessage))
                    {
                        _errors[fieldName] = errorMessage;
                    }
                }
            }
            
            if (!_errors.Any())
            {
                _errorMessage = "Ошибка валидации данных";
            }
        }
        catch
        {
            _errorMessage = "Ошибка обработки ответа сервера";
        }
    }

    private void CancelEditing()
    {
        _isEditing = false;
        _editPatient = null;
        _errorMessage = null;
        _errors.Clear();
    }
}