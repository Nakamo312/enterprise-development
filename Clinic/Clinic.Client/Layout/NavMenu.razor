@using MudBlazor

<MudDrawerHeader Class="pa-4">
    <div class="d-flex flex-column align-center">
        <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Size="Size.Large" />
        </MudAvatar>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-center mt-1">
            Администратор системы
        </MudText>
    </div>
</MudDrawerHeader>

<MudNavMenu Dense="true" Class="px-2">
    <MudNavLink Href="/"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Home"
                IconColor="Color.Primary"
                Class="mb-1">
        Главная
    </MudNavLink>

    <MudNavLink Href="/patients"
                Icon="@Icons.Material.Filled.Person"
                IconColor="Color.Success"
                Class="mb-1">
        Пациенты
    </MudNavLink>

    <MudNavLink Href="/doctors"
                Icon="@Icons.Material.Filled.MedicalServices"
                IconColor="Color.Info"
                Class="mb-1">
        Врачи
    </MudNavLink>

    <MudNavLink Href="/appointments"
                Icon="@Icons.Material.Filled.CalendarToday"
                IconColor="Color.Warning"
                Class="mb-1">
        Приемы
    </MudNavLink>

    <MudNavLink Href="/analytics"
                Icon="@Icons.Material.Filled.Analytics"
                IconColor="Color.Secondary"
                Class="mb-1">
        Аналитика
    </MudNavLink>
</MudNavMenu>

<style>
    .mud-navlink {
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .mud-navlink:hover {
            background-color: rgba(var(--mud-palette-primary-rgb), 0.08);
            transform: translateX(4px);
        }

        .mud-navlink.mud-navlink-active {
            background-color: rgba(var(--mud-palette-primary-rgb), 0.12);
            border-left: 4px solid var(--mud-palette-primary);
            font-weight: 600;
        }
</style>