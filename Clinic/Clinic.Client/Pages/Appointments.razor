@page "/appointments"
@using MudBlazor
@using System.Net.Http.Json
@using Clinic.Client.Components.Appointments
@using Clinic.Application.Dtos.Appointments
@using System.Text.Json;
@using System.Text.Json.Serialization;
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Приёмы - Клиника "Здоровье+"</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">

	<AppointmentsHeader OnCreate="ShowCreateModal" />

	<AppointmentsFilters @ref="_filters" OnChanged="ApplyFilters" />

	@if (_isLoading)
	{
		<div class="text-center py-6">
			<MudProgressCircular Indeterminate Color="Color.Primary" />
		</div>
	}
	else if (_filteredAppointments.Count() == 0)
	{
		<EmptyState Title="Нет записей на приём"
					Message="@(_filterHasValue ? "Попробуйте изменить фильтры" : "Начните с создания первой записи")"
					Icon="@Icons.Material.Filled.EventBusy"
					ButtonText="Создать запись"
					OnClick="ShowCreateModal" />
	}
	else
	{
		<MudTable Items="_filteredAppointments" Hover="true" Dense="true">
			<HeaderContent>
				<MudTh>Дата и время</MudTh>
				<MudTh>Кабинет</MudTh>
				<MudTh>Повторный</MudTh>
				<MudTh></MudTh>
			</HeaderContent>

			<RowTemplate>
				<MudTd DataLabel="Дата и время">@context.DateTime.ToString("dd.MM.yyyy HH:mm")</MudTd>
				<MudTd DataLabel="Кабинет">@context.RoomNumber</MudTd>
				<MudTd DataLabel="Повторный">@((context.IsRepeated) ? "Да" : "Нет")</MudTd>
				<MudTd Class="d-flex align-right">
					<MudIconButton Icon="@Icons.Material.Filled.Visibility"
								   Color="Color.Primary"
								   OnClick="@(() => ShowDetailsModal(context.Id))" />
					<MudIconButton Icon="@Icons.Material.Filled.Delete"
								   Color="Color.Error"
								   OnClick="@(() => HandleDeleteRequest(context.Id))" />
				</MudTd>
			</RowTemplate>
		</MudTable>
	}
</MudContainer>

@code {
	private readonly List<AppointmentListItemDto> _allAppointments = new();
	private List<AppointmentListItemDto> _filteredAppointments = new();
	private AppointmentsFilters? _filters;
	private bool _isLoading;

	private bool _filterHasValue =>
		!string.IsNullOrWhiteSpace(_filters?.Search) ||
		_filters?.SelectedDate != null ||
		_filters?.OnlyRepeated == true;

	protected override async Task OnInitializedAsync()
	{
		await LoadAppointmentsAsync();
	}

	private async Task LoadAppointmentsAsync()
	{
		_isLoading = true;
		try
		{
			var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
			options.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());

			_allAppointments.Clear();
			_allAppointments.AddRange(await Http.GetFromJsonAsync<List<AppointmentListItemDto>>("api/appointments", options) ?? new());

			ApplyFilters();
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Ошибка загрузки данных: {ex.Message}", Severity.Error);
		}
		finally
		{
			_isLoading = false;
		}
	}

	private void ApplyFilters()
	{
		if (_filters == null) return;

		IEnumerable<AppointmentListItemDto> query = _allAppointments;

		if (!string.IsNullOrWhiteSpace(_filters.Search))
			query = query.Where(a => a.RoomNumber?.Contains(_filters.Search, StringComparison.OrdinalIgnoreCase) == true);

		if (_filters.SelectedDate.HasValue)
			query = query.Where(a => a.DateTime.Date == _filters.SelectedDate.Value.Date);

		if (_filters.OnlyRepeated)
			query = query.Where(a => a.IsRepeated);

		_filteredAppointments = query.OrderByDescending(a => a.DateTime).ToList();
	}

	private void ShowCreateModal()
	{
		DialogService.ShowAsync<AppointmentCreateDialog>("Создать запись",
			new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
	}

	private async Task ShowDetailsModal(Guid id)
	{
		try
		{
			var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
			var appointment = await Http.GetFromJsonAsync<AppointmentResponseDto>($"api/appointments/{id}", options);

			if (appointment != null)
			{
				var parameters = new DialogParameters { ["Appointment"] = appointment };
				await DialogService.ShowAsync<AppointmentDetailsDialog>("Детали приёма", parameters,
					new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
			}
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Ошибка при загрузке деталей: {ex.Message}", Severity.Error);
		}
	}

	private async Task HandleDeleteRequest(Guid id)
	{
		bool? confirmed = await DialogService.ShowMessageBox(
			"Подтверждение",
			"Удалить запись?",
			yesText: "Да",
			noText: "Отмена",
			options: new DialogOptions { MaxWidth = MaxWidth.ExtraSmall }
		);

		if (confirmed != true) return;

		var response = await Http.DeleteAsync($"api/appointments/{id}");
		if (response.IsSuccessStatusCode)
		{
			Snackbar.Add("Запись удалена", Severity.Success);
			await LoadAppointmentsAsync();
		}
		else
		{
			Snackbar.Add("Ошибка удаления", Severity.Error);
		}
	}

	public class AppointmentListItemDto
	{
		public Guid Id { get; set; }
		public DateTime DateTime { get; set; }
		public string? RoomNumber { get; set; }
		[JsonPropertyName("isRepeated")]
		public bool IsRepeated { get; set; }
	}
}
