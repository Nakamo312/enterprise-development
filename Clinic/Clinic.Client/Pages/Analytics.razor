@page "/analytics"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using Clinic.Application.Dtos.Doctors
@using Clinic.Application.Dtos.Patients
@using Clinic.Application.Dtos.Appointments
@inject HttpClient Http

<div class="container-fluid">
    <h3 class="mb-4">Аналитика и отчеты</h3>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Врачи по стажу работы</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Минимальный стаж (лет)</label>
                        <div class="input-group">
                            <input type="number" class="form-control" 
                                   min="0" max="50" 
                                   @bind="_experienceYears" 
                                   @bind:event="oninput" />
                            <button class="btn btn-primary" @onclick="LoadDoctorsByExperience">
                                <i class="bi bi-search"></i> Найти
                            </button>
                        </div>
                    </div>
                    
                    @if (_isLoadingDoctors)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="ms-2">Загрузка...</span>
                        </div>
                    }
                    else if (_doctorsByExperience?.Any() == true)
                    {
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>ФИО врача</th>
                                        <th>Год рождения</th>
                                        <th>Стаж</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doctor in _doctorsByExperience)
                                    {
                                        <tr>
                                            <td>@doctor.FullName</td>
                                            <td>@doctor.YearOfBirth</td>
                                            <td>@(doctor.Experience.HasValue ? $"{doctor.Experience.Value} лет" : "Не указан")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">Найдено врачей: @_doctorsByExperience.Count</small>
                    }
                    else if (_doctorsByExperience != null)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Врачи с указанным стажем не найдены
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Пациенты по врачу</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Выберите врача</label>
                        <select class="form-select" @bind="_selectedDoctorId">
                            <option value="">Выберите врача...</option>
                            @foreach (var doctor in _allDoctors)
                            {
                                <option value="@doctor.Id">@doctor.FullName</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-success w-100 mb-3" 
                            disabled="@(_selectedDoctorId == Guid.Empty)" 
                            @onclick="LoadPatientsByDoctor">
                        <i class="bi bi-people"></i> Показать пациентов
                    </button>
                    
                    @if (_isLoadingPatients)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                            <span class="ms-2">Загрузка...</span>
                        </div>
                    }
                    else if (_patientsByDoctor?.Any() == true)
                    {
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>ФИО пациента</th>
                                        <th>Дата рождения</th>
                                        <th>Пол</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in _patientsByDoctor)
                                    {
                                        <tr>
                                            <td>@patient.FullName</td>
                                            <td>@patient.DateOfBirth.ToString("dd.MM.yyyy")</td>
                                            <td>@patient.Gender.ToString()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">Найдено пациентов: @_patientsByDoctor.Count</small>
                    }
                    else if (_patientsByDoctor != null)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> У выбранного врача нет пациентов
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Повторные записи</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Дата начала</label>
                            <input type="date" class="form-control" 
                                   @bind="_repeatedStartDate" 
                                   @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Дата окончания</label>
                            <input type="date" class="form-control" 
                                   @bind="_repeatedEndDate" 
                                   @bind:format="yyyy-MM-dd" />
                        </div>
                    </div>
                    <button class="btn btn-warning w-100 mb-3" @onclick="LoadRepeatedAppointments">
                        <i class="bi bi-calendar-check"></i> Найти повторные записи
                    </button>
                    
                    @if (_isLoadingRepeated)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                            <span class="ms-2">Загрузка...</span>
                        </div>
                    }
                    else if (_repeatedAppointments?.Any() == true)
                    {
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Дата и время</th>
                                        <th>Кабинет</th>
                                        <th>Повторный</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in _repeatedAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.DateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@appointment.RoomNumber</td>
                                            <td>
                                                @if (appointment.IsRepeated)
                                                {
                                                    <span class="badge bg-warning text-dark">Да</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Нет</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">Найдено записей: @_repeatedAppointments.Count</small>
                    }
                    else if (_repeatedAppointments != null)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Повторные записи за указанный период не найдены
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Пациенты 30+ с разными врачами</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        Пациенты старше 30 лет, которые посещали более одного врача
                    </p>
                    <button class="btn btn-info w-100 mb-3" @onclick="LoadPatientsOver30MultipleDoctors">
                        <i class="bi bi-person-check"></i> Показать отчет
                    </button>
                    
                    @if (_isLoadingPatients30Plus)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                            <span class="ms-2">Загрузка...</span>
                        </div>
                    }
                    else if (_patients30Plus?.Any() == true)
                    {
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>ФИО пациента</th>
                                        <th>Дата рождения</th>
                                        <th>Возраст</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in _patients30Plus)
                                    {
                                        var age = CalculateAge(patient.DateOfBirth);
                                        <tr>
                                            <td>@patient.FullName</td>
                                            <td>@patient.DateOfBirth.ToString("dd.MM.yyyy")</td>
                                            <td>@age лет</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">Найдено пациентов: @_patients30Plus.Count</small>
                    }
                    else if (_patients30Plus != null)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Подходящие пациенты не найдены
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Записи по кабинету (текущий месяц)</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Номер кабинета</label>
                        <input type="text" class="form-control" 
                               placeholder="Например: 101" 
                               @bind="_roomNumber" />
                    </div>
                    <button class="btn btn-danger w-100 mb-3" 
                            disabled="@string.IsNullOrWhiteSpace(_roomNumber)" 
                            @onclick="LoadAppointmentsForRoom">
                        <i class="bi bi-door-closed"></i> Найти записи
                    </button>
                    
                    @if (_isLoadingRoomAppointments)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                            <span class="ms-2">Загрузка...</span>
                        </div>
                    }
                    else if (_roomAppointments?.Any() == true)
                    {
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Дата и время</th>
                                        <th>Кабинет</th>
                                        <th>Повторный</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in _roomAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.DateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@appointment.RoomNumber</td>
                                            <td>
                                                @if (appointment.IsRepeated)
                                                {
                                                    <span class="badge bg-warning text-dark">Да</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Нет</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">Найдено записей: @_roomAppointments.Count</small>
                    }
                    else if (_roomAppointments != null)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Записи в указанном кабинете не найдены
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: none;
        min-height: 450px;
        display: flex;
        flex-direction: column;
    }
    
    .card-header {
        border-bottom: none;
        flex-shrink: 0;
    }
    
    .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    
    .table-responsive {
        flex: 1;
        min-height: 0;
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }
    
    .table {
        margin-bottom: 0;
    }
    
    .table th {
        font-weight: 600;
        font-size: 0.875rem;
        border-top: none;
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 1;
    }
    
    .table td {
        font-size: 0.875rem;
    }
    
    .badge {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
    }
    
    .form-control, .form-select, .btn {
        flex-shrink: 0;
    }
    
    .alert {
        flex-shrink: 0;
    }
    
    .text-muted {
        flex-shrink: 0;
        margin-top: 0.5rem;
    }
</style>

@code {
    private readonly JsonSerializerOptions _jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new JsonStringEnumConverter() }
    };
    
    private List<DoctorResponseDto> _allDoctors = new();
    private List<DoctorResponseDto>? _doctorsByExperience;
    private List<PatientResponseDto>? _patientsByDoctor;
    private List<AppointmentResponseDto>? _repeatedAppointments;
    private List<PatientResponseDto>? _patients30Plus;
    private List<AppointmentResponseDto>? _roomAppointments;
    
    private bool _isLoadingDoctors = false;
    private bool _isLoadingPatients = false;
    private bool _isLoadingRepeated = false;
    private bool _isLoadingPatients30Plus = false;
    private bool _isLoadingRoomAppointments = false;
    
    private uint _experienceYears = 5;
    private Guid _selectedDoctorId = Guid.Empty;
    private DateTime _repeatedStartDate = DateTime.Today.AddMonths(-1);
    private DateTime _repeatedEndDate = DateTime.Today;
    private string _roomNumber = "101";
    
    protected override async Task OnInitializedAsync()
    {
        await LoadAllDoctors();
    }
    
    private async Task LoadAllDoctors()
    {
        try
        {
            var doctors = await Http.GetFromJsonAsync<List<DoctorResponseDto>>("api/doctors", _jsonOptions);
            _allDoctors = doctors?.OrderBy(d => d.FullName).ToList() ?? new();
        }
        catch
        {
            _allDoctors = new();
        }
    }
    
    private async Task LoadDoctorsByExperience()
    {
        _isLoadingDoctors = true;
        _doctorsByExperience = null;
        StateHasChanged();
        
        try
        {
            var doctors = await Http.GetFromJsonAsync<List<DoctorResponseDto>>(
                $"api/analytic/doctors/experience?experience={_experienceYears}", 
                _jsonOptions);
            _doctorsByExperience = doctors?.OrderByDescending(d => d.Experience).ToList();
        }
        catch
        {
            _doctorsByExperience = null;
        }
        finally
        {
            _isLoadingDoctors = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadPatientsByDoctor()
    {
        if (_selectedDoctorId == Guid.Empty) return;
        
        _isLoadingPatients = true;
        _patientsByDoctor = null;
        StateHasChanged();
        
        try
        {
            var patients = await Http.GetFromJsonAsync<List<PatientResponseDto>>(
                $"api/analytic/doctors/{_selectedDoctorId}/patients", 
                _jsonOptions);
            _patientsByDoctor = patients?.OrderBy(p => p.FullName).ToList();
        }
        catch
        {
            _patientsByDoctor = null;
        }
        finally
        {
            _isLoadingPatients = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadRepeatedAppointments()
    {
        _isLoadingRepeated = true;
        _repeatedAppointments = null;
        StateHasChanged();
        
        try
        {
            var url = $"api/analytic/appointments/repeated?startDate={_repeatedStartDate:yyyy-MM-dd}&endDate={_repeatedEndDate:yyyy-MM-dd}";
            var appointments = await Http.GetFromJsonAsync<List<AppointmentResponseDto>>(url, _jsonOptions);
            _repeatedAppointments = appointments?.OrderByDescending(a => a.DateTime).ToList();
        }
        catch
        {
            _repeatedAppointments = null;
        }
        finally
        {
            _isLoadingRepeated = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadPatientsOver30MultipleDoctors()
    {
        _isLoadingPatients30Plus = true;
        _patients30Plus = null;
        StateHasChanged();
        
        try
        {
            var patients = await Http.GetFromJsonAsync<List<PatientResponseDto>>(
                "api/analytic/patients/over30-multiple-doctors", 
                _jsonOptions);
            _patients30Plus = patients?.OrderBy(p => p.FullName).ToList();
        }
        catch
        {
            _patients30Plus = null;
        }
        finally
        {
            _isLoadingPatients30Plus = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadAppointmentsForRoom()
    {
        if (string.IsNullOrWhiteSpace(_roomNumber)) return;
        
        _isLoadingRoomAppointments = true;
        _roomAppointments = null;
        StateHasChanged();
        
        try
        {
            var appointments = await Http.GetFromJsonAsync<List<AppointmentResponseDto>>(
                $"api/analytic/appointments/room?roomNumber={Uri.EscapeDataString(_roomNumber)}", 
                _jsonOptions);
            _roomAppointments = appointments?.OrderByDescending(a => a.DateTime).ToList();
        }
        catch
        {
            _roomAppointments = null;
        }
        finally
        {
            _isLoadingRoomAppointments = false;
            StateHasChanged();
        }
    }
    
    private int CalculateAge(DateOnly birthDate)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - birthDate.Year;
        if (birthDate.Month > today.Month || (birthDate.Month == today.Month && birthDate.Day > today.Day))
        {
            age--;
        }
        return age;
    }
}