@page "/analytics"
@using Clinic.Client.Components.Analytics
@using Clinic.Client.Components.Analytics.Cards
@using MudBlazor

<PageTitle>Аналитика</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <AnalyticsHeader />

    <MudGrid Spacing="3" Class="mt-4 align-items-stretch">
        <MudItem xs="12" md="6" Class="d-flex">
            <ExperienceAnalyticsCard Class="flex-grow-1 d-flex flex-column h-100" />
        </MudItem>

        <MudItem xs="12" md="6" Class="d-flex">
            <PatientsByDoctorCard Class="flex-grow-1 d-flex flex-column h-100" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-4 align-items-stretch">
        <MudItem xs="12" md="6" Class="d-flex">
            <RepeatedAppointmentsCard Class="flex-grow-1 d-flex flex-column h-100" />
        </MudItem>

        <MudItem xs="12" md="6" Class="d-flex">
            <Patients30PlusCard Class="flex-grow-1 d-flex flex-column h-100" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-4 align-items-stretch">
        <MudItem xs="12" md="6" Class="d-flex">
            <RoomAppointmentsCard Class="flex-grow-1 d-flex flex-column h-100" />
        </MudItem>
    </MudGrid>
</MudContainer>
