@page "/"
@using Clinic.Client.Components.Dashboard

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <HeaderSection />
    
    <MudGrid Spacing="3">
        <StatisticsCards />
    </MudGrid>
    
    <MudGrid Class="mt-4">
        <MudItem xs="12" md="8">
            <QuickActions @ref="_quickActions" />
        </MudItem>
        <MudItem xs="12" md="4">
            <LiveStatistics />
        </MudItem>
    </MudGrid>
    
    <DayProgressCard />
    <ClinicNews />
    <ClinicActivity />
</MudContainer>

@code {
    private QuickActions? _quickActions;
}