@page "/doctors"
@using MudBlazor
@using System.Net.Http.Json
@using Clinic.Application.Dtos.Doctors
@using Clinic.Application.Dtos.Specializations
@using Clinic.Domain.Models
@using System.Text.Json
@using System.Text.Json.Serialization
@using Clinic.Client.Components.Doctors
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Врачи - Клиника "Здоровье+"</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">

	<DoctorsHeader OnCreate="ShowCreateModal" />

	<DoctorsFilters @ref="_filters" OnChanged="ApplyFilters" />

	@if (_isLoading)
	{
		<div class="text-center py-6">
			<MudProgressCircular Indeterminate Color="Color.Primary" />
		</div>
	}
	else if (_filteredDoctors.Count() == 0)
	{
		<EmptyState Title="Нет врачей"
					Message="@(_filterHasValue ? "Попробуйте изменить фильтры" : "Начните с добавления первого врача")"
					Icon="@Icons.Material.Filled.PersonOff"
					ButtonText="Добавить врача"
					OnClick="ShowCreateModal" />
	}
	else
	{
		<MudTable Items="_filteredDoctors" Hover="true" Dense="true">
			<HeaderContent>
				<MudTh>ФИО</MudTh>
				<MudTh>Паспорт</MudTh>
				<MudTh>Специализация</MudTh>
				<MudTh></MudTh>
			</HeaderContent>

			<RowTemplate>
				<MudTd DataLabel="ФИО">@context.FullName</MudTd>
				<MudTd DataLabel="Паспорт">@context.PassportNumber</MudTd>
				<MudTd DataLabel="Специализация">
					@(_specializations.TryGetValue(context.SpecializationId, out var name) ? name : "Неизвестно")
				</MudTd>
				<MudTd Class="d-flex align-right">
					<MudIconButton Icon="@Icons.Material.Filled.Visibility"
								   Color="Color.Primary"
								   OnClick="@(() => ShowDetailsModal(context.Id))" />
					<MudIconButton Icon="@Icons.Material.Filled.Delete"
								   Color="Color.Error"
								   OnClick="@(() => HandleDeleteRequest(context.Id))" />
				</MudTd>
			</RowTemplate>
		</MudTable>
	}
</MudContainer>

@code {
	private readonly List<DoctorResponseDto> _allDoctors = new();
	private List<DoctorResponseDto> _filteredDoctors = new();
	private DoctorsFilters? _filters;
	private bool _isLoading;

	private readonly Dictionary<Guid, string> _specializations = new();

	private bool _filterHasValue =>
		!string.IsNullOrWhiteSpace(_filters?.SearchName) ||
		!string.IsNullOrWhiteSpace(_filters?.SearchPassport);

	protected override async Task OnInitializedAsync()
	{
		await LoadSpecializationsAsync();
		await LoadDoctorsAsync();
	}

	private async Task LoadSpecializationsAsync()
	{
		try
		{
			var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
			var list = await Http.GetFromJsonAsync<List<SpecializationResponseDto>>("api/specializations", options) ?? new List<SpecializationResponseDto>();

			_specializations.Clear();
			foreach (var spec in list)
			{
				_specializations[spec.Id] = spec.Name;
			}
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Ошибка загрузки специализаций: {ex.Message}", Severity.Error);
		}
	}

	private async Task LoadDoctorsAsync()
	{
		_isLoading = true;
		try
		{
			var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
			options.Converters.Add(new JsonStringEnumConverter());

			_allDoctors.Clear();
			var doctors = await Http.GetFromJsonAsync<List<DoctorResponseDto>>("api/doctors", options) ?? new();
			_allDoctors.AddRange(doctors);

			ApplyFilters();
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Ошибка загрузки данных: {ex.Message}", Severity.Error);
		}
		finally
		{
			_isLoading = false;
		}
	}

	private void ApplyFilters()
	{
		if (_filters == null) return;

		IEnumerable<DoctorResponseDto> query = _allDoctors;

		if (!string.IsNullOrWhiteSpace(_filters.SearchName))
			query = query.Where(d => d.FullName.Contains(_filters.SearchName, StringComparison.OrdinalIgnoreCase));

		if (!string.IsNullOrWhiteSpace(_filters.SearchPassport))
			query = query.Where(d => d.PassportNumber.Contains(_filters.SearchPassport, StringComparison.OrdinalIgnoreCase));

		_filteredDoctors = query.OrderBy(d => d.FullName).ToList();
	}

	private void ShowCreateModal()
	{
		DialogService.ShowAsync<DoctorCreateDialog>("Добавить врача",
			new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
	}

	private async Task ShowDetailsModal(Guid id)
	{
		try
		{
			var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
			options.Converters.Add(new JsonStringEnumConverter());

			var doctorDto = await Http.GetFromJsonAsync<DoctorResponseDto>($"api/doctors/{id}", options);

			if (doctorDto != null)
			{
				var parameters = new DialogParameters { ["Doctor"] = doctorDto };
				await DialogService.ShowAsync<DoctorDetailsDialog>("Детали врача", parameters,
					new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
			}
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Ошибка при загрузке деталей: {ex.Message}", Severity.Error);
		}
	}

	private async Task HandleDeleteRequest(Guid id)
	{
		bool? confirmed = await DialogService.ShowMessageBox(
			"Подтверждение",
			"Удалить врача?",
			yesText: "Да",
			noText: "Отмена",
			options: new DialogOptions { MaxWidth = MaxWidth.ExtraSmall }
		);

		if (confirmed != true) return;

		var response = await Http.DeleteAsync($"api/doctors/{id}");
		if (response.IsSuccessStatusCode)
		{
			Snackbar.Add("Врач удалён", Severity.Success);
			await LoadDoctorsAsync();
		}
		else
		{
			Snackbar.Add("Ошибка удаления", Severity.Error);
		}
	}
}
